# Tavily API Key
# 从这里获取: https://tavily.com/
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Stepfun API Key (Stepfun是阶跃星辰的AI服务)
# 从这里获取: https://platform.stepfun.com/
VITE_STEPFUN_API_KEY=your_stepfun_api_key_here

# Stepfun 模型选择
# 可选: step-3.5-flash, step-3.5-mini, step-2-mini, step-1-flash
VITE_STEPFUN_MODEL=step-3.5-flash